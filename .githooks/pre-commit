#!/bin/sh
# The quick half of CI: formatting and lint. The full run (build, typecheck, example build) is in pre-push.
# Skip with `git commit --no-verify`.
set -e
cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: format check"
pnpm -s format:check || { echo "Run 'pnpm format' to fix, then stage the changes."; exit 1; }
echo "pre-commit: lint"
pnpm -s lint
