#!/bin/sh
# The same steps as .github/workflows/ci.yml, so a push doesn't fail there.
# Skip with `git push --no-verify`.
set -e
cd "$(git rev-parse --show-toplevel)"

echo "pre-push: format check"
pnpm -s format:check || { echo "Run 'pnpm format' to fix, then commit the changes."; exit 1; }
echo "pre-push: lint"
pnpm -s lint
echo "pre-push: build"
pnpm -s build
echo "pre-push: typecheck"
pnpm -s typecheck
echo "pre-push: example build"
pnpm -s --filter example build
